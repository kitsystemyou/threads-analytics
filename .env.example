# Meta Threads API OAuth Credentials
# Create a copy of this file named ".env" or ".env.local" and fill in your app details.
# Get these details from the Meta for Developers portal.

VITE_THREADS_CLIENT_ID=your_threads_client_id_here
VITE_THREADS_CLIENT_SECRET=your_threads_client_secret_here

# Redirect URI must match the one configured in your Meta App settings exactly.
# Note: For local development, this is typically http://localhost:5173/
VITE_THREADS_REDIRECT_URI=http://localhost:5173/
